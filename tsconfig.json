{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "jsx": "react",
    "outDir": "./build",
    "paths": {
      "~/*": ["./inertia/*"],
      "@generated/*": ["./.adonisjs/client/*"]
    }
  },
  "include": [
    "app/**/*",
    "config/**/*",
    "start/**/*",
    "database/**/*",
    "providers/**/*",
    "inertia/**/*",
    ".adonisjs/**/*.d.ts",
    ".adonisjs/**/*.ts"
  ],
  "references": [{ "path": "./tsconfig.inertia.json" }]
}
